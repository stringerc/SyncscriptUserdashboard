# ============================================================================
# CORTEX DISCORD SURFACE — Environment Configuration
# Copy values into .env (never commit real values)
# Spec: CORTEX_DISCORD_SPEC.md · Research: CORTEX_DISCORD_RESEARCH.md
# ============================================================================

# Bot token from Discord Developer Portal → Bot → Token
DISCORD_BOT_TOKEN=

# Ed25519 public key from Developer Portal → General Information
# (used to verify inbound interaction signatures)
DISCORD_PUBLIC_KEY=

# Your Discord user ID — the ONLY account allowed to run commands/approve
# (Discord: Settings → Advanced → Developer Mode → right-click profile → Copy ID)
DISCORD_OWNER_ID=

# Channel where proactive posts (proposals, forecasts, digest) are sent
DISCORD_CHANNEL_ID=

# Optional: private guild ID for instant guild-scoped command registration
# (otherwise commands register globally and can take up to 1h to propagate)
DISCORD_GUILD_ID=

# Local hour (0-23) for the morning digest push. Default: 7
DISCORD_DIGEST_HOUR=7
