# ============================================================================
# SYNCSCRIPT STOREFRONT — Environment Configuration
# Copy to .env.local and fill in your values
# ============================================================================

# ---------------------------------------------------------------------------
# Stripe (Required for payments)
# ---------------------------------------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...                    # Secret key (server-side only)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...   # Publishable key (client-side)
STRIPE_WEBHOOK_SECRET=whsec_...                  # From Stripe CLI: stripe listen --forward-to localhost:3000/api/webhook

# ---------------------------------------------------------------------------
# Storefront URLs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000  # Production: https://store.syncscript.io

# ---------------------------------------------------------------------------
# Download Security (generate with: openssl rand -base64 32)
# ---------------------------------------------------------------------------
DOWNLOAD_SECRET=your-32-byte-base64-secret-here

# ---------------------------------------------------------------------------
# Cloudflare R2 / AWS S3 (for ZIP file hosting)
# ---------------------------------------------------------------------------
# Create bucket at https://dash.cloudflare.com/r2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=syncscript-products
R2_BUCKET_URL=https://pub-xxx.r2.dev  # Public bucket URL or custom domain

# Alternative: AWS S3
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_BUCKET=syncscript-products
# S3_BUCKET_URL=https://syncscript-products.s3.amazonaws.com

# ---------------------------------------------------------------------------
# Email (for fulfillment notifications)
# ---------------------------------------------------------------------------
# Using Resend (recommended): https://resend.com
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@syncscript.io

# Alternative: SendGrid
# SENDGRID_API_KEY=SG...
# FROM_EMAIL=noreply@syncscript.io

# ---------------------------------------------------------------------------
# Gumroad (for discoverability uploads)
# ---------------------------------------------------------------------------
GUMROAD_EMAIL=thecsholdinggroup@gmail.com
GUMROAD_PASSWORD=@Sup3rDup3rChris1991

# ---------------------------------------------------------------------------
# Feature Flags
# ---------------------------------------------------------------------------
ENABLE_GUMROAD_UPLOAD=true
ENABLE_STRIPE_CHECKOUT=true
ENABLE_EMAIL_FULFILLMENT=false  # Set true after email provider configured
