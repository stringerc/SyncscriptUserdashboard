{
  "buildCommand": "vite build",
  "outputDirectory": "build",
  "devCommand": "vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
