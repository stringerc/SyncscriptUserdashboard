              const landingCss = `/* ==========================================================================
   Design Tokens & Modern Dark Theme
   ========================================================================== */
:root {
  --bg-primary: #060813;
  --bg-surface: rgba(15, 23, 42, 0.7);
  --bg-card: rgba(30, 41, 59, 0.45);
  --border-subtle: rgba(255, 255, 255, 0.08);
  --border-hover: rgba(0, 240, 255, 0.4);
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --text-dim: #64748b;
  --cyan: #00f0ff;
  --cyan-glow: rgba(0, 240, 255, 0.25);
  --violet: #8b5cf6;
  --violet-glow: rgba(139, 92, 246, 0.25);
  --green: #10b981;
  --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-body: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 20px;
  --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}

* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  background-color: var(--bg-primary);
  color: var(--text-main);
  font-family: var(--font-body);
  line-height: 1.6;
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
}

/* Ambient Backdrops */
.ambient-glow {
  position: fixed;
  width: 500px;
  height: 500px;
  border-radius: 50%;
  filter: blur(120px);
  pointer-events: none;
  z-index: 0;
  opacity: 0.35;
}
.glow-1 {
  top: -100px;
  left: 15%;
  background: radial-gradient(circle, var(--cyan), transparent 70%);
}
.glow-2 {
  top: 40%;
  right: 5%;
  background: radial-gradient(circle, var(--violet), transparent 70%);
}

/* Header & Glassmorphic Navbar */
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  background: rgba(6, 8, 19, 0.75);
  border-bottom: 1px solid var(--border-subtle);
  padding: 16px 24px;
}
.nav-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  cursor: pointer;
}
.brand-logo {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--cyan), var(--violet));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 16px;
  color: #fff;
  box-shadow: 0 0 15px var(--cyan-glow);
}
.brand-name {
  font-family: var(--font-heading);
  font-weight: 700;
  font-size: 18px;
  letter-spacing: -0.02em;
}
.nav-links {
  display: flex;
  gap: 28px;
}
.nav-link {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: var(--transition);
}
.nav-link:hover {
  color: var(--cyan);
}

/* Buttons */
.btn {
  padding: 10px 20px;
  border-radius: var(--radius-sm);
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  border: none;
  transition: var(--transition);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.btn-primary {
  background: linear-gradient(135deg, #00f0ff, #8b5cf6);
  color: #060813;
  box-shadow: 0 4px 20px var(--cyan-glow);
}
.btn-primary:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 25px rgba(0, 240, 255, 0.4);
}
.btn-secondary {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid var(--border-subtle);
  color: var(--text-main);
}
.btn-secondary:hover {
  background: rgba(255, 255, 255, 0.1);
  border-color: rgba(255, 255, 255, 0.2);
}
.btn-glow {
  background: rgba(0, 240, 255, 0.15);
  border: 1px solid var(--cyan);
  color: var(--cyan);
}
.btn-glow:hover {
  background: var(--cyan);
  color: #060813;
  box-shadow: 0 0 20px var(--cyan-glow);
}

/* Hero Section */
.hero {
  max-width: 900px;
  margin: 80px auto 60px;
  text-align: center;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}
.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 6px 14px;
  border-radius: 999px;
  background: rgba(0, 240, 255, 0.08);
  border: 1px solid rgba(0, 240, 255, 0.25);
  font-size: 12px;
  font-weight: 600;
  color: var(--cyan);
  margin-bottom: 24px;
}
.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 8px var(--green);
}
.hero-title {
  font-family: var(--font-heading);
  font-size: 56px;
  font-weight: 800;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-bottom: 20px;
  background: linear-gradient(135deg, #ffffff 30%, #00f0ff 70%, #8b5cf6 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}
.hero-subtitle {
  font-size: 18px;
  color: var(--text-muted);
  max-width: 680px;
  margin: 0 auto 36px;
  font-weight: 400;
}
.hero-actions {
  display: flex;
  gap: 16px;
  justify-content: center;
  margin-bottom: 50px;
}

/* Telemetry Bar */
.telemetry-bar {
  display: inline-flex;
  align-items: center;
  gap: 40px;
  padding: 16px 36px;
  background: var(--bg-surface);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  backdrop-filter: blur(12px);
}
.telemetry-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.telemetry-val {
  font-family: var(--font-heading);
  font-size: 20px;
  font-weight: 700;
  color: var(--text-main);
}
.telemetry-lbl {
  font-size: 11px;
  color: var(--text-dim);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-top: 2px;
}

/* Bento Grid */
.features-section {
  max-width: 1100px;
  margin: 40px auto 80px;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}
.section-header {
  text-align: center;
  margin-bottom: 40px;
}
.section-title {
  font-family: var(--font-heading);
  font-size: 32px;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin-bottom: 12px;
}
.section-subtitle {
  font-size: 15px;
  color: var(--text-muted);
  max-width: 580px;
  margin: 0 auto;
}
.grid-bento {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 24px;
}
.card {
  background: var(--bg-card);
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-md);
  padding: 30px;
  backdrop-filter: blur(16px);
  transition: var(--transition);
  position: relative;
  overflow: hidden;
}
.card:hover {
  transform: translateY(-4px);
  border-color: var(--border-hover);
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4), 0 0 20px var(--cyan-glow);
}
.card-icon {
  font-size: 28px;
  margin-bottom: 18px;
}
.card-title {
  font-family: var(--font-heading);
  font-size: 18px;
  font-weight: 600;
  margin-bottom: 10px;
}
.card-desc {
  font-size: 14px;
  color: var(--text-muted);
  line-height: 1.5;
}

/* Interactive Section */
.interactive-section {
  max-width: 900px;
  margin: 0 auto 100px;
  padding: 0 20px;
  position: relative;
  z-index: 1;
}
.interactive-card {
  background: #0d121f;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
}
.widget-header {
  padding: 16px 20px;
  border-bottom: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(15, 23, 42, 0.5);
}
.widget-title {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 13px;
  font-weight: 600;
}
.status-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--cyan);
  box-shadow: 0 0 8px var(--cyan);
}
.widget-tabs {
  display: flex;
  gap: 6px;
}
.tab-btn {
  padding: 6px 12px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted);
  cursor: pointer;
}
.tab-btn.active {
  background: rgba(255, 255, 255, 0.08);
  border-color: var(--border-subtle);
  color: var(--text-main);
}
.widget-body {
  padding: 30px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}
.demo-display h4 {
  font-family: var(--font-heading);
  font-size: 18px;
  margin: 12px 0 6px;
}
.demo-display p {
  font-size: 13px;
  color: var(--text-muted);
  margin-bottom: 20px;
}
.demo-badge {
  font-size: 11px;
  color: var(--green);
  text-transform: uppercase;
  font-weight: 600;
  letter-spacing: 0.05em;
}
.console-box {
  background: #060810;
  border: 1px solid var(--border-subtle);
  border-radius: var(--radius-sm);
  padding: 16px;
  font-family: 'SF Mono', Menlo, monospace;
  font-size: 12px;
  color: #38bdf8;
  height: 140px;
  overflow-y: auto;
}
.console-line {
  margin-bottom: 4px;
}

/* Footer */
.footer {
  border-top: 1px solid var(--border-subtle);
  padding: 24px 20px;
  font-size: 13px;
  color: var(--text-dim);
  background: rgba(6, 8, 19, 0.9);
}
.footer-container {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.footer-status {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--text-muted);
}

@media (max-width: 768px) {
  .hero-title { font-size: 38px; }
  .widget-body { grid-template-columns: 1fr; }
  .nav-links { display: none; }
  .telemetry-bar { gap: 20px; padding: 12px 20px; }
}
`;

              const landingJs = `// Interactive Scripts for ${title}
console.log('⚡ [Live Sandbox] Booted: ${title}');

function triggerInteractiveDemo() {
  const consoleBox = document.getElementById('console-output');
  if (!consoleBox) return;
  const line = document.createElement('div');
  line.className = 'console-line';
  line.style.color = '#10b981';
  line.textContent = '→ dispatch :: user trigger at ' + new Date().toLocaleTimeString();
  consoleBox.appendChild(line);
  consoleBox.scrollTop = consoleBox.scrollHeight;
}

function runSimulatedTask() {
  const consoleBox = document.getElementById('console-output');
  const metric = document.getElementById('metric-latency');
  if (metric) {
    const nextLatency = (Math.random() * 2 + 3.1).toFixed(1) + 'ms';
    metric.textContent = nextLatency;
  }
  if (!consoleBox) return;
  const steps = [
    'attending :: parsing neural state vector...',
    'integrating :: phi calculated at 1.28 (+0.04)',
    'executing :: closed-loop sensorimotor confirmed'
  ];
  steps.forEach((msg, idx) => {
    setTimeout(() => {
      const line = document.createElement('div');
      line.className = 'console-line';
      line.textContent = '» ' + msg;
      consoleBox.appendChild(line);
      consoleBox.scrollTop = consoleBox.scrollHeight;
    }, idx * 300);
  });
}

function switchTab(tabName) {
  const buttons = document.querySelectorAll('.tab-btn');
  buttons.forEach(b => b.classList.remove('active'));
  if (event && event.target) {
    event.target.classList.add('active');
  }
  const consoleBox = document.getElementById('console-output');
  if (consoleBox) {
    const line = document.createElement('div');
    line.className = 'console-line';
    line.style.color = '#c084fc';
    line.textContent = 'tab :: switched to ' + tabName;
    consoleBox.appendChild(line);
  }
}
`;

